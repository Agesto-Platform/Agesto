# Copie para .env na VM (cp .env.example .env) e preencha. O .env NUNCA vai para o Git.

# Domínio público da API. Provisório: api.<IP com hífens>.sslip.io (ex.: api.129-151-1-2.sslip.io).
API_DOMAIN=api.IP-COM-HIFENS.sslip.io

# Supabase: use a connection string do "Session pooler" (IPv4), não a conexão direta.
ConnectionStrings__DefaultConnection=Host=aws-0-sa-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.SEU_PROJETO;Password=SUA_SENHA;SSL Mode=Require;Trust Server Certificate=true

# Gere com: openssl rand -base64 32
Jwt__Secret=GERE_UMA_CHAVE_LONGA

# Domínio da web na Cloudflare Pages.
Cors__AllowedOrigins__0=https://agesto.pages.dev
